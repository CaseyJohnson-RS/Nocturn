{
  "uid": "nocturn-slo",
  "title": "Nocturn — SLO & Error Budget",
  "description": "Are we meeting our objectives, and how much budget is left? Definitions live in docs/SLO.md.",
  "tags": ["nocturn", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Availability SLO — 99.5% of requests not 5xx (30d)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "30-day compliance",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "1 - nocturn:availability:error_ratio30d", "legendFormat": "achieved" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "min": 0.98,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.993 },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "gauge",
      "title": "Error budget remaining",
      "description": "100% = untouched budget. Below 0 means the SLO is already missed for this window.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "refId": "A", "expr": "nocturn:availability:budget_remaining_ratio", "legendFormat": "remaining" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "timeseries",
      "title": "Availability burn rate",
      "description": "Error ratio divided by the 0.5% budget. Above 1 = burning faster than sustainable; 14.4 exhausts 30 days of budget in 2 days.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "nocturn:availability:error_ratio5m / 0.005", "legendFormat": "5m" },
        { "refId": "B", "expr": "nocturn:availability:error_ratio1h / 0.005", "legendFormat": "1h" },
        { "refId": "C", "expr": "nocturn:availability:error_ratio6h / 0.005", "legendFormat": "6h" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Latency SLO — 99% of non-AI requests under 250 ms",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Share of requests slower than 250 ms",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "targets": [
        { "refId": "A", "expr": "nocturn:latency:error_ratio5m", "legendFormat": "5m" },
        { "refId": "B", "expr": "nocturn:latency:error_ratio1h", "legendFormat": "1h" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Latency burn rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "targets": [
        { "refId": "A", "expr": "nocturn:latency:error_ratio5m / 0.01", "legendFormat": "5m" },
        { "refId": "B", "expr": "nocturn:latency:error_ratio1h / 0.01", "legendFormat": "1h" },
        { "refId": "C", "expr": "nocturn:latency:error_ratio6h / 0.01", "legendFormat": "6h" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "AI responsiveness SLO — p95 time-to-first-token under 3 s",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Time to first token",
      "description": "What the user actually waits for before text starts appearing in the chat.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(nocturn_llm_time_to_first_token_seconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        { "refId": "B", "expr": "nocturn:llm_ttft:p95", "legendFormat": "p95" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 3 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "LLM provider call outcome",
      "description": "The provider is a hard dependency for chat but not for notes CRUD — this panel says which half of the product is degraded.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(nocturn_llm_requests_total[5m]))",
          "legendFormat": "{{operation}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 25, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*error.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Freshness SLO — 95% of notes searchable within 60 s of a save",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Age of the oldest pending embedding task",
      "description": "The upper bound on how stale semantic search can be. Crossing 60 s means the SLO is at risk; 300 s pages.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 25 },
      "targets": [
        { "refId": "A", "expr": "nocturn_embedding_queue_oldest_pending_seconds", "legendFormat": "oldest pending" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } }
    }
  ]
}
